# ---------------------------------------------------------------------------
# Frontend (read by the browser; never put secrets in NEXT_PUBLIC_ variables)
# ---------------------------------------------------------------------------

# true: use the built-in mock API (no backend needed). false: call the real API.
NEXT_PUBLIC_USE_MOCKS=true

# Base URL of the backend API, used when NEXT_PUBLIC_USE_MOCKS is not "true".
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Mocks only: share of requests that fail on purpose (0 to 1), to exercise
# error states. Defaults to 0.05. Set 0 for demos.
NEXT_PUBLIC_MOCK_ERROR_RATE=0.05
# Mocks only: the signed-in user's role, "admin" or "employee" (default: admin in development).
NEXT_PUBLIC_MOCK_ROLE=

# ---------------------------------------------------------------------------
# Authentication: Microsoft Entra ID (server-only; never prefix with NEXT_PUBLIC_)
# Setup steps: README → Authentication.
# ---------------------------------------------------------------------------
# Encrypts the session cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-random-secret

# Public URL of this app, no trailing slash. Production: https://leaderboard.crocomind.com
BETTER_AUTH_URL=http://localhost:3000

# Azure portal → App registrations → Croco Creators → Overview
AUTH_MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
AUTH_MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Certificates & secrets → New client secret → copy the "Value" (not the "Secret ID")
AUTH_MICROSOFT_CLIENT_SECRET=your-client-secret-value

# Who may sign in: comma-separated email domains
AUTH_ALLOWED_EMAIL_DOMAINS=crocobet.com

# Optional: the backend API's scope (Expose an API), e.g. api://<api-client-id>/access_as_user.
# When set, API requests carry the signed-in user's access token. Public, not a secret.
NEXT_PUBLIC_API_SCOPE=

# ---------------------------------------------------------------------------
# Backend only: Supabase (not used by the frontend)
# https://app.supabase.com/project/_/settings/api
# Never prefix these with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
