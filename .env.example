# ---------------------------------------------------------------------------
# Frontend (read by the browser; never put secrets in NEXT_PUBLIC_ variables)
# ---------------------------------------------------------------------------

# true: use the built-in mock API (no backend needed). false: call the real API.
NEXT_PUBLIC_USE_MOCKS=true

# Base URL of the backend API, used when NEXT_PUBLIC_USE_MOCKS is not "true".
# /api/v1 is the backend in this repo.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Mocks only: share of requests that fail on purpose (0 to 1), to exercise
# error states. Defaults to 0.05. Set 0 for demos.
NEXT_PUBLIC_MOCK_ERROR_RATE=0.05
# Mocks only: the signed-in user's role, "admin" or "employee" (default: admin in development).
NEXT_PUBLIC_MOCK_ROLE=

# ---------------------------------------------------------------------------
# Authentication: Microsoft Entra ID (server-only; never prefix with NEXT_PUBLIC_)
# Setup steps: README → Authentication.
# ---------------------------------------------------------------------------
# Encrypts the session cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-random-secret

# Public URL of this app, no trailing slash. Production: https://leaderboard.crocomind.com
BETTER_AUTH_URL=http://localhost:3000

# Azure portal → App registrations → Croco Creators → Overview
AUTH_MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
AUTH_MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Certificates & secrets → New client secret → copy the "Value" (not the "Secret ID")
AUTH_MICROSOFT_CLIENT_SECRET=your-client-secret-value

# Who may sign in: comma-separated email domains
AUTH_ALLOWED_EMAIL_DOMAINS=crocobet.com

# Leave empty for the backend in this repo (it uses the session cookie, and
# sign-in then asks for Microsoft Graph User.Read to copy names and photos).
# Only for an external API: its scope, e.g. api://<api-client-id>/access_as_user.
NEXT_PUBLIC_API_SCOPE=

# ---------------------------------------------------------------------------
# Backend (server-only; never prefix with NEXT_PUBLIC_). Setup: README → Backend.
# ---------------------------------------------------------------------------
# Supabase Postgres, transaction pooler (port 6543):
# Project → Connect → Transaction pooler
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Migrations only (npm run db:migrate): the session pooler or direct connection (port 5432).
MIGRATIONS_DATABASE_URL=

# Vercel Cron sends it as a Bearer token. Generate one with: openssl rand -base64 32
CRON_SECRET=

# Where post metrics come from: apify (automatic, public data through Apify's
# scrapers), fixture (fake data for development) or manual (admins enter every
# number). Default: fixture, or manual on Vercel production. Per platform:
# POST_DATA_PROVIDER_INSTAGRAM, _FACEBOOK, _TIKTOK, _LINKEDIN.
POST_DATA_PROVIDER=

# Apify (POST_DATA_PROVIDER=apify): apify.com → Settings → API & Integrations →
# Personal API token. Without it, "apify" falls back to manual entry.
APIFY_API_TOKEN=
# Cost cap per scraper run, in US dollars (default 1).
APIFY_MAX_CHARGE_USD=1
# Optional: another scraper per platform, e.g. apimaestro~linkedin-post-detail.
# APIFY_ACTOR_INSTAGRAM= APIFY_ACTOR_FACEBOOK= APIFY_ACTOR_TIKTOK= APIFY_ACTOR_LINKEDIN=

# Comma-separated admin emails. Empty: tekizashvili@crocobet.com and
# gbedoshvili@crocobet.com. Setting it replaces that list.
ADMIN_EMAILS=

# The challenge dates until an admin sets them in the app (Admin → Leaderboards),
# as ISO date-times with an offset. The dates set in the app win.
CHALLENGE_STARTS_AT=2026-10-06T00:00:00+04:00
CHALLENGE_ENDS_AT=2027-01-06T00:00:00+04:00
CAMPAIGN_TIMEZONE=Asia/Tbilisi

# The campaign tag: posts need the hashtag and a tag of Croco Squad.
# Mentions empty: @croco.squad on Instagram, "Croco Squad" on TikTok and
# Facebook, "crocobet.com | Croco Squad" on LinkedIn. "none": only the hashtag.
# Or your own, e.g. instagram:croco.squad,facebook:Croco Squad
CAMPAIGN_HASHTAGS=CrocoBySquad
CAMPAIGN_MENTIONS=

# Days after the challenge ends that submissions and metric refreshes continue.
SUBMISSION_GRACE_DAYS=3
METRICS_GRACE_DAYS=3

# The suspicious_growth flag: views or reactions grew by more than both.
GROWTH_FLAG_FACTOR=5
GROWTH_FLAG_MIN=1000

# ---------------------------------------------------------------------------
# Supabase API keys (reserved; the backend talks to Postgres directly)
# https://app.supabase.com/project/_/settings/api
# Never prefix these with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
